{
  "name": "enquiry-desk",
  "version": "0.1.0",
  "description": "A contact form backend: checks each enquiry, logs it to Google Sheets, emails the sender a confirmation through Resend, and tells you what it is about.",
  "main": "lib/enquiry.js",
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc",
    "dev": "vite web",
    "build": "vite build web --outDir ../dist --emptyOutDir",
    "build:single": "SINGLE=1 vite build web --outDir ../dist-single --emptyOutDir"
  },
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
